}
.count {
  font: 500 11px/1 var(--mono);
  color: var(--dim);
}
.progress {
  height: 2px;
  margin: 12px 0 6px;
  background: var(--line);
}
.progress i {
  display: block;
  height: 100%;
  background: var(--teal);
  transition: width 0.3s;
}
.tasks ul {
  list-style: none;
  margin: 0;
  padding: 0;
}
.task {
  width: 100%;
  display: grid;
  grid-template-columns: 18px 1fr auto;
  gap: 12px;
  align-items: start;
  padding: 11px 0;
