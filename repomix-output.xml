<file path="src/App.css">
/* Selena — flight-deck UI. No external fonts or assets: the ship has no internet. */

:root {
  --bg: #070c11;
  --panel: rgba(15, 25, 34, 0.7);
  --line: rgba(170, 200, 212, 0.13);
  --line2: rgba(170, 200, 212, 0.28);
  --text: #ebe6da;
  --dim: #94a3ab;
  --faint: #5d6d76;

  --teal: #43c0ae;
  --teal-s: rgba(67, 192, 174, 0.2);
  --amber: #e8af4e;
  --amber-s: rgba(232, 175, 78, 0.2);
  --red: #f0603f;
  --red-s: rgba(240, 96, 63, 0.22);
  --clay: #c68b5c;
  --steel: #7fa4c4;

  --sans: "Inter", "SF Pro Text", system-ui, "Segoe UI", "Helvetica Neue", sans-serif;
  --mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

[data-level="nominal"] {
  --c: var(--teal);
  --cs: var(--teal-s);
}
[data-level="watch"] {
  --c: var(--amber);
  --cs: var(--amber-s);
}
[data-level="critical"] {
  --c: var(--red);
  --cs: var(--red-s);
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-size: 13px;
  line-height: 1.45;
  font-feature-settings: "tnum";
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}

button {
  font: inherit;
  color: inherit;
}

::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-thumb {
  background: var(--line2);
}

/* ───────── shell ───────── */

.app {
  position: relative;
  height: 100%;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 14px;
  padding: 16px 18px 18px;
  background:
    radial-gradient(900px 520px at 12% -8%, rgba(67, 192, 174, 0.13), transparent 60%),
    radial-gradient(800px 600px at 100% 110%, rgba(198, 139, 92, 0.12), transparent 60%),
    radial-gradient(600px 400px at 55% 40%, rgba(127, 164, 196, 0.06), transparent 70%),
    var(--bg);
}

.app::before {
  /* blueprint grid */
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(170, 200, 212, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(170, 200, 212, 0.045) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(ellipse at 50% 45%, #000 20%, transparent 78%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 45%, #000 20%, transparent 78%);
}

.app::after {
  /* critical vignette */
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.6s;
  box-shadow: inset 0 0 160px 10px rgba(240, 96, 63, 0.38);
}
.app[data-level="critical"]::after {
  opacity: 1;
  animation: breathe 2.4s ease-in-out infinite;
}

@keyframes breathe {
  50% {
    opacity: 0.45;
  }
}

.app > * {
  position: relative;
  z-index: 1;
}

.boot {
  height: 100%;
  display: grid;
  place-content: center;
  gap: 8px;
  text-align: center;
  color: var(--dim);
}

/* ───────── type bits ───────── */

.eyebrow {
  font: 500 10px/1 var(--mono);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--faint);
}

.dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--c);
  box-shadow: 0 0 0 3px var(--cs);
  flex: none;
}

/* ───────── header ───────── */

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.mark {
  width: 16px;
  height: 16px;
  border: 1px solid var(--clay);
  border-radius: 50%;
  position: relative;
}
.mark::after {
  content: "";
  position: absolute;
  inset: 3px 3px 3px 7px;
  background: var(--clay);
  border-radius: 0 8px 8px 0;
}

.wordmark {
  font: 600 15px/1 var(--mono);
  letter-spacing: 0.34em;
}

.tag {
  font: 400 11px/1 var(--mono);
  color: var(--faint);
  letter-spacing: 0.06em;
  padding-left: 12px;
  border-left: 1px solid var(--line2);
}

.top-meta {
  display: flex;
  gap: 8px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 11px;
  border: 1px solid var(--line);
  background: rgba(15, 25, 34, 0.5);
  font: 500 11px/1 var(--mono);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.chip[data-level] {
  border-color: var(--c);
  color: var(--c);
}

/* ───────── layout ───────── */

.main {
  display: grid;
  grid-template-columns: 308px minmax(0, 1fr) 352px;
  gap: 14px;
  min-height: 0;
}

.col {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-height: 0;
  overflow-y: auto;
}

.panel {
  position: relative;
  padding: 16px;
  border: 1px solid var(--line);
  background: var(--panel);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.panel::before,
.panel::after {
  content: "";
  position: absolute;
  width: 9px;
  height: 9px;
  border: 1px solid var(--clay);
  pointer-events: none;
}
.panel::before {
  top: -1px;
  left: -1px;
  border-right: 0;
  border-bottom: 0;
}
.panel::after {
  right: -1px;
  bottom: -1px;
  border-left: 0;
  border-top: 0;
}

/* ───────── hazards ───────── */

.hazards {
  list-style: none;
  margin: 14px 0 0;
  padding: 0;
}
.hazards li {
  display: grid;
  grid-template-columns: 22px 1fr auto;
  gap: 10px;
  align-items: start;
  padding: 11px 0;
  border-top: 1px solid var(--line);
}
.idx {
  font: 500 10px/1.6 var(--mono);
  color: var(--faint);
}
.hz-name {
  font-weight: 500;
}
.hz-detail {
  font-size: 11px;
  color: var(--dim);
}
.hz-value {
  display: flex;
  align-items: center;
  gap: 8px;
  font: 500 11px/1.6 var(--mono);
  color: var(--c);
  white-space: nowrap;
}

/* link */

.link-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 14px 0 10px;
  font: 500 10px/1 var(--mono);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dim);
}
.link-line {
  flex: 1;
  height: 1px;
  background: repeating-linear-gradient(90deg, var(--line2) 0 4px, transparent 4px 8px);
  position: relative;
}
.link-line i {
  position: absolute;
  top: -2px;
  left: 0;
  width: 5px;
  height: 5px;
  background: var(--steel);
  border-radius: 50%;
  animation: travel 4s linear infinite;
}
@keyframes travel {
  to {
    left: calc(100% - 5px);
  }
}
.link-text {
  font-size: 11px;
  color: var(--dim);
}

/* demo */

.demo {
  display: grid;
  gap: 8px;
}
.demo .eyebrow {
  margin-bottom: 4px;
}

.btn {
  padding: 10px 12px;
  background: transparent;
  border: 1px solid var(--line2);
  font: 500 11px/1 var(--mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.btn:hover:not(:disabled) {
  background: rgba(170, 200, 212, 0.08);
}
.btn:disabled {
  opacity: 0.35;
  cursor: default;
}
.btn.danger {
  border-color: rgba(240, 96, 63, 0.55);
  color: var(--red);
}
.btn.danger:hover:not(:disabled) {
  background: var(--red-s);
}

/* ───────── center ───────── */

.center {
  overflow: hidden;
}

