import { useCallback, useEffect, useState } from "react";
import { invoke } from "@tauri-apps/api/core";
import "./App.css";
import type { BodyZone, HealthReport, Level } from "./types";
import { I18N, type Lang } from "./i18n";

const HISTORY = 90;

interface History {
  hr: number[];
  sys: number[];
  spo2: number[];
  dose: number[];
}
const EMPTY: History = { hr: [], sys: [], spo2: [], dose: [] };
const push = (a: number[], v: number) => [...a.slice(-(HISTORY - 1)), v];

function Spark({ data, minSpan }: { data: number[]; minSpan: number }) {
  const W = 120;
  const H = 34;
  if (data.length < 2) return <svg className="spark" viewBox={`0 0 ${W} ${H}`} />;
  const lo = Math.min(...data);
  const hi = Math.max(...data);
  const span = Math.max(hi - lo, minSpan);
  const mid = (hi + lo) / 2;
  const min = mid - span / 2;
  const pts = data.map((v, i) => {
    const x = (i / (data.length - 1)) * W;
    const y = H - 3 - ((v - min) / span) * (H - 6);
    return `${x.toFixed(1)} ${y.toFixed(1)}`;
  });
  const line = `M${pts.join(" L")}`;
  return (
    <svg className="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      <path className="spark-area" d={`${line} L${W} ${H} L0 ${H} Z`} />
      <path className="spark-line" d={line} />
    </svg>
  );
}

function Cell(props: {
  label: string;
  value: string;
  unit: string;
  level: Level;
  data?: number[];
  minSpan?: number;
}) {
  return (
    <div className="cell" data-level={props.level}>
      <div className="eyebrow">{props.label}</div>
      <div className="cell-value">
        {props.value}
        <span className="unit">{props.unit}</span>
      </div>
      {props.data ? <Spark data={props.data} minSpan={props.minSpan ?? 1} /> : <div className="spark" />}
    </div>
  );
}

const HOTSPOTS = [
  { id: "brain", x: 180, y: 44, side: "l" },
  { id: "eyes", x: 180, y: 72, side: "r" },
  { id: "heart", x: 198, y: 188, side: "r" },
  { id: "lungs", x: 158, y: 198, side: "l" },
  { id: "radiation", x: 180, y: 290, side: "r" },
  { id: "bones", x: 150, y: 430, side: "l" },
] as const;

const TORSO_RINGS: [number, number, number][] = [
  [160, 118, 242],
  [190, 114, 246],
  [220, 112, 248],
  [250, 111, 249],
  [280, 114, 246],
  [310, 121, 239],
];
const LEG_RINGS: [number, number, number][] = [
  [380, 126, 177],
  [430, 123, 172],
  [480, 120, 168],
  [530, 121, 164],
  [575, 123, 159],
];
const ARM_RINGS: [number, number, number][] = [
  [200, 87, 113],
  [240, 81, 107],
  [280, 76, 98],
];

const ring = (y: number, xl: number, xr: number) => `M${xl} ${y} Q180 ${y + 9} ${xr} ${y}`;
const mirror = (y: number, xl: number, xr: number): [number, number, number] => [y, 360 - xr, 360 - xl];

function BodyMap({
  zones,
  selected,
  onSelect,
  radiationLevel,
  lang,
}: {
  zones: BodyZone[];
  selected: string;
  onSelect: (id: string) => void;
  radiationLevel: Level;
  lang: Lang;
}) {
  const t = I18N[lang];

  return (
    <svg className="bodymap" viewBox="0 0 560 620" role="img" aria-label="Astronaut body map">
      <defs>
        <radialGradient id="aura" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stopColor="var(--c)" stopOpacity="0.35" />
          <stop offset="100%" stopColor="var(--c)" stopOpacity="0" />
        </radialGradient>
      </defs>

      <g transform="translate(100 0)">
        <ellipse className="aura" data-level={radiationLevel} cx="180" cy="300" rx="190" ry="330" fill="url(#aura)" />

        <g className="figure">
          <ellipse cx="180" cy="72" rx="32" ry="40" />
          <path className="inner" d="M150 62 Q180 70 210 62 M148 78 Q180 88 212 78 M156 94 Q180 102 204 94 M180 32 L180 112" />
          <path d="M168 110 L170 130 M192 110 L190 130" />
          <path d="M120 142 Q150 128 170 128 L190 128 Q210 128 240 142 L250 250 Q246 300 232 330 L128 330 Q114 300 110 250 Z" />
          <path d="M120 142 L92 160 L74 292 L94 298 L114 196 L120 160 Z" />
          <path d="M240 142 L268 160 L286 292 L266 298 L246 196 L240 160 Z" />
          <path d="M128 330 L120 480 L124 590 L158 590 L168 480 L180 340" />
          <path d="M232 330 L240 480 L236 590 L202 590 L192 480 L180 340" />
          <path d="M128 330 L232 330" />
          <g className="inner">
            {TORSO_RINGS.map(([y, a, b]) => (
              <path key={`t${y}`} d={ring(y, a, b)} />
            ))}
            {LEG_RINGS.map(([y, a, b]) => (
              <path key={`ll${y}`} d={ring(y, a, b)} />
            ))}
            {LEG_RINGS.map(([y, a, b]) => {
              const [yy, aa, bb] = mirror(y, a, b);
              return <path key={`lr${y}`} d={ring(yy, aa, bb)} />;
            })}
            {ARM_RINGS.map(([y, a, b]) => (
              <path key={`al${y}`} d={ring(y, a, b)} />
            ))}
            {ARM_RINGS.map(([y, a, b]) => {
              const [yy, aa, bb] = mirror(y, a, b);
              return <path key={`ar${y}`} d={ring(yy, aa, bb)} />;
            })}
          </g>
          <g className="skeleton">
            <path d="M180 128 L180 330" />
            <path d="M150 345 L146 485 M210 345 L214 485" />
          </g>
          <path className="ground" d="M60 604 L300 604 M60 598 L60 610 M120 600 L120 608 M180 598 L180 610 M240 600 L240 608 M300 598 L300 610" />
        </g>

        {HOTSPOTS.map((h) => {
          const z = zones.find((zz) => zz.id === h.id);
          if (!z) return null;
          const left = h.side === "l";
          const lx = left ? -88 : 448;
          const zoneKey = h.id as keyof typeof t.zones;
          const localizedName = t.zones[zoneKey]?.name ?? z.name;

          return (
            <g
              key={h.id}
              className="hs"
              data-level={z.level}
              data-selected={selected === h.id}
              role="button"
              tabIndex={0}
              onClick={() => onSelect(h.id)}
              onKeyDown={(e) => (e.key === "Enter" || e.key === " ") && onSelect(h.id)}
            >
              <line className="hs-leader" x1={left ? lx : h.x} y1={h.y} x2={left ? h.x : lx} y2={h.y} />
              <text className="hs-name" x={lx} y={h.y - 7} textAnchor={left ? "start" : "end"}>
                {localizedName}
              </text>
              <text className="hs-metric" x={lx} y={h.y + 15} textAnchor={left ? "start" : "end"}>
                {lang === "ru"
                  ? z.metric
                      .replace("Sleep", "Сон")
                      .replace("Mood", "Настроение")
                      .replace("Optic scan overdue", "УЗИ нерва: просрочено")
                      .replace("Optic scan logged", "УЗИ нерва: записано")
                      .replace("ARED pending", "ARED: ожидает")
                      .replace("ARED logged", "ARED: выполнено")
                      .replace("HR", "ЧСС")
                      .replace("BP", "АД")
                  : z.metric}
              </text>
              <circle className="hs-pulse" cx={h.x} cy={h.y} r="7" />
              <circle className="hs-ring" cx={h.x} cy={h.y} r="11" />
              <circle className="hs-dot" cx={h.x} cy={h.y} r="4.5" />
              <circle className="hs-hit" cx={h.x} cy={h.y} r="16" />
            </g>
          );
        })}
      </g>
    </svg>
  );
}

export default function App() {
  const [report, setReport] = useState<HealthReport | null>(null);
  const [hist, setHist] = useState<History>(EMPTY);
  const [selected, setSelected] = useState("heart");
  const [error, setError] = useState<string | null>(null);
  const [lang, setLang] = useState<Lang>("ru"); // По умолчанию русский!

  const t = I18N[lang];

  const pull = useCallback(async () => {
    try {
      const r = await invoke<HealthReport>("get_health_report");
      setReport(r);
      setError(null);
      setHist((h) => ({
        hr: push(h.hr, r.vitals.heartRateBpm),
        sys: push(h.sys, r.vitals.systolicMmhg),
        spo2: push(h.spo2, r.vitals.spo2Pct),
        dose: push(h.dose, r.environment.doseRateUsvH),
      }));
    } catch (e) {
      setError(String(e));
    }
  }, []);

  const run = useCallback(async (cmd: string, args?: Record<string, unknown>) => {
    try {
      setReport(await invoke<HealthReport>(cmd, args));
      setError(null);
    } catch (e) {
      setError(String(e));
    }
  }, []);

  useEffect(() => {
    pull();
    const id = setInterval(pull, 1000);
    return () => clearInterval(id);
  }, [pull]);

  if (!report) {
    return (
      <div className="boot">
        <div className="eyebrow">Selena core</div>
        <div>{error ? `Backend unreachable: ${error}` : "Starting on-board engine…"}</div>
      </div>
    );
  }

  const zone = report.zones.find((z) => z.id === selected) ?? report.zones[0];
  const zoneKey = zone.id as keyof typeof t.zones;
  const localizedZone = t.zones[zoneKey];

  const radiation = report.zones.find((z) => z.id === "radiation")?.level ?? "nominal";
  const heart = report.zones.find((z) => z.id === "heart")?.level ?? "nominal";
  const lungs = report.zones.find((z) => z.id === "lungs")?.level ?? "nominal";
  const brain = report.zones.find((z) => z.id === "brain")?.level ?? "nominal";
  const v = report.vitals;
  const doneCount = report.tasks.filter((task) => task.done).length;

  return (
    <div className="app" data-level={report.level}>
      <header className="top">
        <div className="brand">
          <span className="mark" />
          <span className="wordmark">SELENA</span>
          <span className="tag">{t.systemTitle}</span>
        </div>
        <div className="top-meta">
          {/* ТУМБЛЕР ЯЗЫКА */}
          <div className="chip" style={{ cursor: "pointer", userSelect: "none" }}>
            <span
              onClick={() => setLang("en")}
              style={{
                color: lang === "en" ? "var(--teal)" : "var(--faint)",
                fontWeight: lang === "en" ? 700 : 400,
              }}
            >
              EN
            </span>
            <span style={{ color: "var(--line2)" }}>/</span>
            <span
              onClick={() => setLang("ru")}
              style={{
                color: lang === "ru" ? "var(--teal)" : "var(--faint)",
                fontWeight: lang === "ru" ? 700 : 400,
              }}
            >
              RU
            </span>
          </div>

          <span className="chip">
            <span className="eyebrow">{t.mission}</span> {t.day} {report.missionDay}
          </span>
          <span className="chip" data-level={report.level}>
            <span className="dot" /> {t.levels[report.level]}
          </span>
          <span className="chip">
            <span className="eyebrow">{t.mode}</span> {report.autonomous ? t.autonomous : t.linked}
          </span>
        </div>
      </header>

      {report.alert && (
        <section className="alert">
          <div className="alert-head">
            <div className="eyebrow">{t.emergencyProtocol}</div>
            <h2>{t.alertTitle}</h2>
            <p>{t.alertSummary}</p>
          </div>
          <ol className="alert-steps">
            {t.alertSteps.map((stepText, i) => (
              <li key={i}>
                <span className="step-n">{String(i + 1).padStart(2, "0")}</span>
                {stepText}
              </li>
            ))}
          </ol>
        </section>
      )}

      <main className="main">
        {/* ЛЕВАЯ КОЛОНКА */}
        <aside className="col">
          <section className="panel">
            <div className="eyebrow">{t.fiveHazards}</div>
            <ul className="hazards">
              {report.hazards.map((h, i) => {
                const hzKey = h.id as keyof typeof t.hazards;
                const locHazard = t.hazards[hzKey];
                return (
                  <li key={h.id} data-level={h.level}>
                    <span className="idx">{String(i + 1).padStart(2, "0")}</span>
                    <div className="hz-body">
                      <div className="hz-name">{locHazard?.name ?? h.name}</div>
                      <div className="hz-detail">{locHazard?.detail ?? h.detail}</div>
                    </div>
                    <div className="hz-value">
                      <span className="dot" />
                      {h.value}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>

          <section className="panel link">
            <div className="eyebrow">{t.earthLink}</div>
            <div className="link-row">
              <span>{t.houston}</span>
              <div className="link-line">
                <i />
              </div>
              <span>{t.crew}</span>
            </div>
            <div className="link-text">{t.commsDelayText(report.commsDelayMin)}</div>
          </section>

          <section className="panel demo">
            <div className="eyebrow">{t.demoControls}</div>
            <button className="btn danger" onClick={() => run("trigger_solar_event")} disabled={!!report.alert}>
